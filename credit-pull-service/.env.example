# ── Supabase (shared with the CRM) ────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE=eyJhbGciOiJI...your-service-role-jwt...

# ── Per-consumer API keys ─────────────────────────────────────────────
# Format: key:label,key:label,...
# Each consumer gets its own key. Label appears in audit logs.
CREDIT_PULL_API_KEYS=crm-key-abc123:CRM,loanapp-key-def456:LoanApplications,website-key-ghi789:Website

# ── CORS allow-list ──────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=https://crm.your-domain.com,https://loans.your-domain.com,https://www.your-domain.com,http://localhost:5055

# ── IdentityIQ portal ────────────────────────────────────────────────
IIQ_URL=https://gcpstage.identityiq.com/

# ── Scraper browser mode ─────────────────────────────────────────────
# Set to false for local debugging (you'll see the browser).
# Production should use true.
IIQ_HEADLESS=true

# ── Server ───────────────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=INFO
# FLASK_DEBUG=1  # uncomment for local dev only
